# ─────────────────────────────────────────────────────────────────────────────
# Zuschlag.ai — example environment. Copy to `.env` and replace every
# `change-me-*` value. `.env` is git-ignored and scanned by gitleaks.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO

# --- Data residency (EU only; the API refuses to start otherwise) -----------
CLOUD_PROVIDER=aws                 # aws | azure
CLOUD_REGION=eu-central-1          # aws: eu-central-1 (Frankfurt) | azure: germanywestcentral

# --- PostgreSQL 16 + pgvector (docker compose) -------------------------------
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
ZUSCHLAG_DB_NAME=zuschlag
ZUSCHLAG_MIGRATOR_PASSWORD=change-me-migrator
ZUSCHLAG_APP_PASSWORD=change-me-app
# Runtime connection: non-owner role, always subject to RLS
DATABASE_URL=postgresql+asyncpg://zuschlag_app:change-me-app@localhost:5432/zuschlag
# Alembic connection: schema owner
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://zuschlag_migrator:change-me-migrator@localhost:5432/zuschlag

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@localhost:6379/0

# --- Object storage (MinIO locally, S3 eu-central-1 in production) -----------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=zuschlag-rfq-attachments
S3_ACCESS_KEY_ID=change-me-minio-user
S3_SECRET_ACCESS_KEY=change-me-minio-password

# --- API security ------------------------------------------------------------
# Exact origins only — wildcards are rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
# HMAC key for pseudonymising client IPs in audit_logs (ip_sha256).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_IP_HMAC_KEY=change-me-64-hex-chars
# dev_headers trusts X-Tenant-ID / X-Actor-ID — refused when ENVIRONMENT=production.
AUTH_MODE=dev_headers

# --- LLM (zero data retention, EU inference) --------------------------------
# Provider: bedrock (Claude via Amazon Bedrock in eu-central-1) | disabled
LLM_PROVIDER=disabled
LLM_MODEL=anthropic.claude-opus-5-5
LLM_AWS_REGION=eu-central-1
# Set to true ONLY once a zero-data-retention agreement is in place for this
# account. The client refuses to send any request while this is false.
LLM_ZDR_ATTESTED=false

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Zuschlag.ai
API_INTERNAL_URL=http://localhost:8000
