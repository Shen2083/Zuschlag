{
  "name": "@zuschlag/sap-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Shared SAP IDoc schemas (JSON Schema source of truth, generated TypeScript types, runtime validators).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/generate.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3"
  }
}
